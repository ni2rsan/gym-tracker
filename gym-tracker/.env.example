# Database
# Local dev: matches docker-compose.yml defaults
# Production: use Neon pooled connection string with ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://gymuser:gympass@localhost:5432/gymtracker"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (add your production URL too: https://yourdomain.com/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Sign In
# 1. Go to https://developer.apple.com/account/resources/identifiers/list/serviceId
# 2. Create a Services ID (this is AUTH_APPLE_ID)
# 3. Enable "Sign In with Apple" and configure domains + redirect URL
# 4. Create a private key and note Team ID + Key ID
# 5. AUTH_APPLE_SECRET is a JSON string: {"teamId":"TEAMID","privateKey":"-----BEGIN PRIVATE KEY-----\n...","keyId":"KEYID"}
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Withings OAuth (for body metrics sync)
WITHINGS_CLIENT_ID=""
WITHINGS_CLIENT_SECRET=""
WITHINGS_REDIRECT_URI=""

# Token encryption (generate with: openssl rand -hex 32)
# Optional — if not set, Withings tokens stored as plaintext
TOKEN_ENCRYPTION_KEY=""
